# ---------- local development (copy to .env) ----------
APP_ENV=dev
DATABASE_URL=sqlite:///./agentbudget.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
RAIL=mock
VENDOR_BASE=http://127.0.0.1:8001

# ---------- production (set in Render, never commit) ----------
# APP_ENV=prod
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ALLOWED_ORIGINS=https://<your-app>.lovable.app
# ALLOWED_ORIGIN_REGEX=https://([a-z0-9-]+\.)*(lovable\.app|lovableproject\.com)
# PUBLIC_DEMO=true                 # judges can use the dashboard without the operator token (sandbox only)
# OPERATOR_TOKEN=...               # from scripts/generate_secrets.py
# AGENT_KEYS=...                   # from scripts/generate_secrets.py
# AGENT_WALLET_KEYS=...            # from scripts/generate_secrets.py
# RAIL=paykit
# NETWORK=localnet                 # Surfpool sandbox; or devnet
# RPC_URL=https://402.surfnet.dev:8899
# VENDOR_BASE=https://agentbudget-vendors.onrender.com
