# Reference for the environment variables. Set them in Render -> each service -> Environment.
# Never commit real values.

# ---------- agentbudget-api ----------
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
APP_SECRET=<any long random string>          # Render generates it; agent keys and test wallets derive from it
OPERATOR_TOKEN=<any long random string>      # Render generates it; needed when PUBLIC_DEMO=false
PUBLIC_DEMO=true                             # judges can use the dashboard without the token
RAIL=paykit
NETWORK=localnet
RPC_URL=https://402.surfnet.dev:8899
VENDOR_BASE=https://agentbudget-vendors.onrender.com
ALLOWED_ORIGINS=https://<your-app>.lovable.app
ALLOWED_ORIGIN_REGEX=https://([a-z0-9-]+\.)*(lovable\.app|lovableproject\.com)

# Optional overrides (normally not needed):
# AGENT_KEYS=research-agent:<key>,intern-agent:<key>
# AGENT_WALLET_KEYS=research-agent:<base58 secret>,intern-agent:<base58 secret>   (python scripts/generate_secrets.py)

# ---------- agentbudget-vendors ----------
# PAYWALL=on
# VENDOR_NETWORK=solana_localnet
